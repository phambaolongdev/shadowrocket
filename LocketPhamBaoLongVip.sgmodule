#!name=Locket 30s
#!desc=Được tổng hợp bởi Phạm Bảo Long
#!author=pbl
#!moduleUrl=https://raw.githubusercontent.com/phambaolongdev/shadowrocket/refs/heads/main/LocketPhamBaoLongVip.sgmodule 

[Script]

#!name=Locket Custom Edition
#!desc=Crack By PhamBaoLong | Tùy chỉnh Video & Caption cá nhân.


[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com

[Script]
# 1. Tùy chỉnh Feature, Video 60s & Caption cá nhân
locket_remote = type=http-response, pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-.*, script-path=https://raw.githubusercontent.com/phambaolongdev/shadowrocket/refs/heads/main/js/Locket_GoldPBL.js, requires-body=true, max-size=524288, timeout=60

# 2. Xóa ETag Header chống dính Cache (by pbl)
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/phambaolongdev/shadowrocket/refs/heads/main/js/deleteHeader.js, timeout=60

# 3. Kích hoạt Gold & Ngày 25/05/1111 (by nguyencongan)
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/phambaolongdev/shadowrocket/refs/heads/main/js/LocketPhamBaoLong.js, requires-body=true, max-size=-1, timeout=60
